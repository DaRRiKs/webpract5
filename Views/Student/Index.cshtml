@model IEnumerable<Student>

@{
    ViewData["Title"] = "Студенты";
}

<h1>Студенты</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<p><a class="btn btn-primary" asp-action="Create">Добавить студента</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>ФИО</th>
            <th>Группа</th>
            <th>Курс</th>
            <th>Email</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.FullName</td>
            <td>@student.Group</td>
            <td>@student.Course</td>
            <td>@student.Email</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@student.Id">Подробнее</a>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@student.Id">Изменить</a>
                <form class="d-inline" asp-action="Delete" asp-route-id="@student.Id" method="post" onsubmit="return confirm('Удалить студента?');">
                    <button class="btn btn-sm btn-danger" type="submit">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
