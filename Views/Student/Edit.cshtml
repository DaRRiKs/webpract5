@model Student?

@{
    ViewData["Title"] = "Изменить студента";
}

<h1>Изменить студента</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model != null)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="FullName">ФИО</label>
            <input class="form-control" asp-for="FullName" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Group">Группа</label>
            <input class="form-control" asp-for="Group" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Course">Курс</label>
            <input class="form-control" asp-for="Course" type="number" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email">Email</label>
            <input class="form-control" asp-for="Email" type="email" />
        </div>
        <button class="btn btn-primary" type="submit">Сохранить</button>
        <a class="btn btn-secondary" asp-action="Index">К списку</a>
    </form>
}
else
{
    <a asp-action="Index">К списку</a>
}
